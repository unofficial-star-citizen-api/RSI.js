{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "typeRoots": [
      "../node_modules/@types"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationDir": null,
    "noEmit": true,
    "rootDir": ".."
  },
  "include": [
    "../src/**/*",
    "./**/*"
  ]
}