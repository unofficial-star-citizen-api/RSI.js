{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.declarations.json",
  "readme": "README.md",
  "exclude": ["**/*.test.ts", "**/mocks/**"],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "gitRevision": "main",
  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "outputs": [{ "name": "clean-jsdoc-theme", "path": "site" }],
  "cleanJsdocTheme": {
    "siteName": "RSI.js",
    "docs": "docs"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Enum",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias"
  ]
}
