              ],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "flfq5",
              "text": "Biome audio has had a significant correction this build. Sound emitters were moving around even while the player stood still, which caused biome ambience to stack on itself and jitter. Levski has also had a mix fix, where ambient audio was excessively loud and audible throughout the entire station rather than staying in its own areas.",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "1aqdh",
              "text": "Further biome audio mixing across Nyx",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "74fn1",
              "text": "Potential Fix: Biome ambience stacking and jittering while the player was stationary",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "3trvq",
              "text": "Potential Fix: Levski ambient audio being excessively loud and carrying across the whole station",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "9v6b9",
              "text": "",
