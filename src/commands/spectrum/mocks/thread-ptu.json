                  "style": "BOLD"
                }
              ],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "fmgdt",
              "text": "A wind pass has gone through the Nyx I flora, with several plants reprocessed using skeletal meshes so they move more convincingly. Cloud ambient occlusion has had further tuning, and the ocean rendering now fades its reflections out over long distances, which should stop the odd mirrored artifacts previously visible from orbit.",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "bsq33",
              "text": "Water settings cleaned up, with orphaned regions no longer left behind when settings change",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
