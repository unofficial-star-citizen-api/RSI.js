#!/bin/sh

# This pre-commit hook runs linting and tests before allowing a commit to be made on the main branch.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" != "main" ]; then
    exit 0
fi

pnpm run lint:fix
if [ $? -ne 0 ]; then
    exit 1
fi

# add all modified files to the staging area
git add -u

