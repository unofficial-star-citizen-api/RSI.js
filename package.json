{
  "name": "@unofficial-star-citizen-api/rsi.js",
  "version": "0.0.0",
  "packageManager": "pnpm@12.15.0",
  "description": "A TypeScript library for retrieving Star Citizen data from the Roberts Space Industries website",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.declarations.json",
    "build:watch": "node build.mjs --watch",
    "declarations:watch": "tsc -p tsconfig.declarations.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "check": "pnpm run lint && pnpm run test",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "star-citizen",
    "rsi",
    "roberts-space-industries",
    "api",
    "scraper"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficial-star-citizen-api/RSI.js.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "esbuild": "^0.28.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "axios": "^1.16.0",
    "cheerio": "^1.2.0"
  }
}
