{
  "name": "@unofficial-star-citizen-api/rsi.js",
  "version": "1.0.0",
  "description": "A TypeScript library for retrieving Star Citizen data from the Roberts Space Industries website",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs && tsc -p tsconfig.declarations.json",
    "build:watch": "rollup -c --bundleConfigAsCjs --watch",
    "declarations:watch": "tsc -p tsconfig.declarations.json --watch",
    "dev": "concurrently \"npm run build:watch\" \"npm run declarations:watch\"",
    "test": "jest",
    "lint": "npx eslint .",
    "prepare": "npm run build"
  },
  "keywords": [
    "star-citizen",
    "rsi",
    "roberts-space-industries",
    "api",
    "scraper"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficial-star-citizen-api/RSI.js.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.8.2",
    "cheerio": "^1.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "rollup": "^4.34.9",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
