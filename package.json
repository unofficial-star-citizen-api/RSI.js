{
  "name": "@unofficial-star-citizen-api/rsi.js",
  "version": "0.0.0",
  "description": "A TypeScript library for retrieving Star Citizen data from the Roberts Space Industries website",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.esm.js",
      "require": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.declarations.json",
    "build:watch": "node build.mjs --watch",
    "declarations:watch": "tsc -p tsconfig.declarations.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "npx eslint .",
    "check": "npm run lint && npm run test",
    "ci": "npm run lint && npm run test && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "star-citizen",
    "rsi",
    "roberts-space-industries",
    "api",
    "scraper"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficial-star-citizen-api/RSI.js.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.15",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^10.3.0",
    "esbuild": "^0.25.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "axios": "^1.16.0",
    "cheerio": "^1.2.0"
  }
}
